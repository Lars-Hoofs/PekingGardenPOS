@{
    string nav = (string?)ViewData["Nav"] ?? "";
}
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Peking Garden</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app @ViewData["AppClass"]">
    <aside class="rail">
        <div class="merk"><img class="glyph" src="~/icons/logo.svg" alt=""><b>Peking Garden</b></div>
        <nav class="nav">
            <a class="@(nav == "tables" ? "actief" : "")" asp-page="/Tables/Index"><span>Tafels</span></a>
        </nav>
    </aside>
    @RenderBody()
</div>
</body>
</html>